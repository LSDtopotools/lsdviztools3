    given-names: Simon M.
    orcid: "https://orcid.org/0000-0002-1357-8501"
    affiliation: "School of GeoSciences, University of Edinburgh, Edinburgh, United Kingdom"
    email: simon.m.mudd@ed.ac.uk
  - family-names: Vervoordeldonk
    given-names: Rutger
    orcid: "https://orcid.org/0000-0001-9680-4094"
    affiliation: "School of GeoSciences, University of Edinburgh, Edinburgh, United Kingdom"
repository-code: "https://github.com/LSDtopotools/lsdviztools3"
url: "https://lsdtopotools.github.io/lsdviztools3/"
license: MIT
keywords:
  - geomorphology
  - topographic analysis
  - visualisation
  - PyGMT
  - digital elevation models
  - LSDTopoTools
